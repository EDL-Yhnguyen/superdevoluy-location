# Clé secrète Stripe (Tableau de bord Stripe > Développeurs > Clés API). Mode test : sk_test_..., production : sk_live_...
STRIPE_SECRET_KEY=

# URL publique du site (utilisée pour les retours de paiement)
SITE_URL=https://superdevoluy-location.vercel.app

# Calendriers iCal exportés par les plateformes, séparés par des virgules.
# Airbnb : Calendrier > Disponibilités > Connecter des calendriers > Exporter.
# Booking : Extranet > Tarifs et disponibilités > Synchroniser les calendriers > Exporter.
# Abritel : Calendrier > Importer/Exporter > Exporter.
ICAL_URLS=
